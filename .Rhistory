library(ggplot2)
library(ggspatial)
install.packages("ggspatial")
library(ggspatial)
# Minimal dissertation theme — no basemap text, just coastline and graticules
theme_thames_map <- function(base_size = 10) {
theme_minimal(base_size = base_size) +
theme(
panel.grid       = element_line(colour = "grey92", linewidth = 0.2),
panel.background = element_rect(fill = "aliceblue", colour = NA),
axis.title       = element_blank(),
axis.text        = element_text(colour = "grey40", size = base_size - 2),
plot.title       = element_text(face = "bold", size = base_size + 1),
legend.position  = "right"
)
}
# Common map decorations: scale bar + north arrow
map_decorations <- function() {
list(
annotation_scale(
location   = "bl",
style      = "ticks",
line_width = 0.4,
text_cex   = 0.7
),
annotation_north_arrow(
location = "tl",
which_north = "true",
style = north_arrow_minimal(),
height = unit(0.8, "cm"),
width  = unit(0.8, "cm")
)
)
}
install.packages("ggrepel")
install.packages("rnaturalearthhires")
install.packages("rnaturalearthhires", repos = "https://ropensci.r-universe.dev")
install.packages("rnaturalearth")
install.packages("patchwork")
library(tidyverse)
library(sf)
library(ggrepel)
library(rnaturalearth)
library(rnaturalearthhires)   # install.packages("rnaturalearthhires", repos = "https://ropensci.r-universe.dev")
library(patchwork)
source("./utils/mapper.R")
# ---- Load gauges and number them west -> east (downstream order) ----
gauges <- read.csv("./3_Cleaned/00_gauge_metadata.csv") %>%
select(SiteName, Easting, Northing) %>%   # adjust if column indices change
st_as_sf(coords = c("Easting", "Northing"), crs = 27700) %>%
mutate(east = st_coordinates(.)[, 1]) %>%
arrange(east) %>%
mutate(id = row_number(),
label = paste0(id, ". ", SiteName))
# ---- Coastline, projected to BNG ----
coast <- ne_countries(scale = 10, country = "United Kingdom",
returnclass = "sf") %>%
st_transform(27700)
# Bounding box for the main map, with a buffer
bb <- st_bbox(gauges) + c(-15000, -10000, 15000, 15000)
# ---- Main overview map ----
main <- ggplot() +
geom_sf(data = coast, fill = "grey96", colour = "grey60", linewidth = 0.25) +
geom_sf(data = gauges, size = 2, colour = "black") +
geom_label_repel(
data = gauges,
aes(geometry = geometry, label = label),
stat = "sf_coordinates",
size = 2.8,
label.padding = unit(0.15, "lines"),
box.padding   = 0.45,
point.padding = 0.25,
segment.colour = "grey45",
segment.size   = 0.25,
min.segment.length = 0,
max.overlaps = Inf,
seed = 1
) +
coord_sf(xlim = c(bb["xmin"], bb["xmax"]),
ylim = c(bb["ymin"], bb["ymax"]),
crs = 27700, expand = FALSE) +
map_decorations() +
theme_thames_map() +
labs(title = "Thames tide gauge network")
# ---- Optional: inset for the London cluster (Richmond -> Charlton) ----
london_ids   <- 1:4                # adjust after inspecting `gauges`
london_box   <- st_bbox(gauges %>% filter(id %in% london_ids)) +
c(-3000, -2000, 3000, 2000)
london_inset <- ggplot() +
geom_sf(data = coast, fill = "grey96", colour = "grey60", linewidth = 0.2) +
geom_sf(data = gauges, size = 1.6) +
geom_label_repel(
data = gauges %>% filter(id %in% london_ids),
aes(geometry = geometry, label = label),
stat = "sf_coordinates", size = 2.4,
box.padding = 0.3, segment.size = 0.2,
min.segment.length = 0, max.overlaps = Inf, seed = 1
) +
coord_sf(xlim = c(london_box["xmin"], london_box["xmax"]),
ylim = c(london_box["ymin"], london_box["ymax"]),
crs = 27700, expand = FALSE) +
theme_thames_map(base_size = 8) +
labs(title = "Inset: Greater London")
# ---- Combine and save ----
final <- main + london_inset + plot_layout(widths = c(2.2, 1))
ggsave("./outputs/thames_tide_gauges.pdf", final,
width = 11, height = 6, device = cairo_pdf)
ggsave("./outputs/thames_tide_gauges.png", final,
width = 11, height = 6, dpi = 300)
